# このファイルをコピーして .env を作成し、実際の値を設定してください。
# .env はGit管理対象外（.gitignore参照）です。パスワード等の秘密情報はコミットしないこと。
#
# cp .env.example .env

# DB_HOST / DB_NAME / DB_USER は省略した場合、config.php既定値（localhost / contact_form / contact_form_app）が使われます。
DB_HOST=localhost
DB_NAME=contact_form
DB_USER=contact_form_app
DB_PASS=

# reCAPTCHA v2（チェックボックス）。省略した場合はGoogle公開のテスト用キー（常に検証成功する）が使われます。
# 本番運用前に、Google reCAPTCHA管理コンソールで取得した実際のサイトキー・秘密鍵に差し替えてください。
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# メール送信。trueにすると、送信内容をstorage/mail_log.txtに記録するだけでなく、
# 下記のSMTP設定で実際にメールを送信する（省略時はfalse＝研修用モックのまま）。
MAIL_SEND_REAL=

# SMTP設定（MAIL_SEND_REAL=trueの場合のみ必要）。Gmailを使う場合の例:
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME に送信元にするGmailアドレス、MAIL_SMTP_PASSWORD に
# 「アプリパスワード」（通常のログインパスワードではなく、Googleアカウントの
# セキュリティ設定＞アプリパスワードで別途発行した16文字のもの）を設定してください。
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# 管理者通知メール（F-08）の宛先。省略時は本番想定のsupport@chatplus.jp。
# ローカルで実際にメール送信を試す際、本番アドレス宛では届かないため、一時的に
# 自分のメールアドレスに変更したい場合はここで上書きする（本番投入前に空欄に戻すこと）。
ADMIN_NOTIFY_EMAIL=

# trueにすると、フリーメールアドレス（gmail.com等）禁止のバリデーションを一時的に無効化する。
# ローカルで自分のフリーメールアドレス宛に実際の送信を確認したい場合のみ使用し、
# 本番投入前に必ず空欄またはfalseに戻すこと（要件定義書6章・データ設計書2.1章で確定済みの仕様）。
ALLOW_FREE_MAIL_FOR_TESTING=
